# Downloaded reference genomes (re-fetchable from NCBI; see the fetch script)
# ---------------------------------------------------------------------------
*.fna
*.fna.gz
11_epigenome_integration/data/ncbi_genomes/
11_epigenome_integration/data/ncbi_genomes_all_species/

