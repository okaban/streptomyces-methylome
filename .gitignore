# Regenerable large intermediates. Recomputable from the deposited data with
# the scripts in this repo; excluded because they exceed GitHub's file limits.
# ---------------------------------------------------------------------------
*_pileup.bed
*_modonly.tsv

# BLAST / alignment indexes (rebuild with makeblastdb / STAR / hisat2-build)
*.nsq
*.nin
*.nhr
*.ndb
*.not
*.ntf
*.nto
star_index/
hisat2_index/

# antiSMASH output bundle (regenerate from the reference GenBank)
11_epigenome_integration/analysis/antismash_output/

# ---------------------------------------------------------------------------
# Working files that should never have been candidates for commit
# ---------------------------------------------------------------------------
.DS_Store
*~
*.bak
*.bak_*
.bak_*
temp/
tmp/
*_tmp/

