#!/bin/sh
# Analysis repo pre-commit gate (installed via: git config core.hooksPath hooks)
# 1) supersession tripwire: a retired value appearing in a canonical output blocks the commit
# 2) figure rules, when the commit touches figures or their producing scripts
# 3) refuses to commit files that must never be evidence (stale/archived)
set -e
cd "$(git rev-parse --show-toplevel)"
PY=$(command -v python3 || command -v python)
STAGED=$(git diff --cached --name-only)

if echo "$STAGED" | grep -q "^11_epigenome_integration/analysis/"; then
  "$PY" 11_epigenome_integration/analysis/make_analysis_index.py --check \
    || { echo "[pre-commit] supersession tripwire FAILED"; exit 1; }
fi

# The figure gate inspects Writing/fig_images/ against the manuscript. Editing an
# analysis table cannot change those, while a commit touching only 15_paper_figures/
# can -- so it is triggered by 15_paper_figures/, the directory whose output
# becomes the manuscript figure set. A plot inside an analysis directory is not
# a manuscript figure and must not trigger it (fixed 2026-10-12).
# figure rules: producing script registered, shared style applied, NAR width,
# palette constants imported, colour separability, text-collision assert present
# the cd must happen INSIDE the subshell that runs the checker, or the checker
# runs in the repo root and fails with "No such file"
if echo "$STAGED" | grep -q "^15_paper_figures/"; then
  ( cd "$HOME/obsidian/Research/rna-seq/Writing" && "$PY" check_figures.py ) \
    || { echo "[pre-commit] figure gate FAILED"; exit 1; }
fi

if echo "$STAGED" | grep -q "is_exposed_STALE_n57\|_ARCHIVED_\|\.bak_"; then
  echo "[pre-commit] refusing to commit stale/backup files:"
  echo "$STAGED" | grep "is_exposed_STALE_n57\|_ARCHIVED_\|\.bak_"; exit 1
fi
exit 0
